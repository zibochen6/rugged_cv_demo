# Install as /etc/seg-demo/visual-hub.env with mode 0600.
# Never commit real credentials.
FRONT_CAMERA_URL=rtsp://USER:PASSWORD@FRONT_CAMERA_IP:554/
REAR_CAMERA_URL=rtsp://USER:PASSWORD@REAR_CAMERA_IP:554/
DMS_CAMERA=usb:0
HUB_PORT=8000
SEG_DEMO_RUNTIME_OVERRIDES=/home/seeed/workspace/seg_demo/configs/_runtime_overrides.yaml
# Optional: keep recordings on a larger mounted disk when available.
VISUAL_HUB_RECORDING_ROOT=/home/seeed/Videos/visual-hub
